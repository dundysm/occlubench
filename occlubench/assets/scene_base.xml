<!-- OccluBench tabletop scene without a robot. Self-authored (MIT, see LICENSE).
     A robot (gantry.xml or the Menagerie Franka Panda) is attached at load time. -->
<mujoco model="occlubench_tabletop_base">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="10"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>
  <default>
    <geom solref="0.004 1" solimp="0.95 0.99 0.001" friction="1.2 0.02 0.001"/>
    <default class="visual"><geom contype="0" conaffinity="0" group="1"/></default>
  </default>
  <worldbody>
    <light pos="0 0 2.0" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" type="plane" size="2 2 0.05" rgba="0.35 0.35 0.38 1"/>
    <geom name="table" type="box" pos="0 0 0.38" size="0.45 0.45 0.02" rgba="0.62 0.5 0.36 1"/>
    <site name="goal" pos="0.18 0.15 0.401" size="0.005" rgba="0 0 0 0"/>
    <geom name="goal_marker" class="visual" type="cylinder" pos="0.18 0.15 0.4005" size="0.06 0.0006" rgba="0.2 0.8 0.3 1"/>
    <camera name="third_person" pos="0.0 -0.6 0.95" xyaxes="1 0 0 0 0.7 0.714" fovy="58"/>

    <body name="cube" pos="-0.12 -0.08 0.42">
      <freejoint name="cube"/>
      <geom name="cube_geom" type="box" size="0.02 0.02 0.02" rgba="0.85 0.1 0.1 1" mass="0.05" friction="1.5 0.05 0.001"/>
    </body>

    <!-- Physical occluder: mocap body with no collision. Rendered by every camera. -->
    <body name="occluder" mocap="true" pos="0 0 3">
      <geom name="occluder_geom" type="box" size="0.06 0.06 0.003" rgba="0.55 0.55 0.6 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
